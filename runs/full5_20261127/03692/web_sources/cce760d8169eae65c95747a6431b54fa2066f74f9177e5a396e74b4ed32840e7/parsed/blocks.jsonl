{"document_id": "original", "page_number": 1, "section_id": "SEC001", "section_title": "翰森制药集团有限公司 / 人才发展政策", "paragraph_id": "original__docling__p1_005", "block_type": "paragraph", "text": "全球化人才布局：围绕重点疾病及技术领域，面向全球引进高层次人才。目前， 翰森制药已构建覆盖中国上海、连云港、常州及美国马里兰的全球化研发架构， 建立了不同民族、不同年龄、不同职业背景、不同性别的跨国人才梯队。", "bbox": {"l": 90.024, "t": 497.3739829101563, "r": 510.024, "b": 427.31989595363456, "coord_origin": "BOTTOMLEFT"}, "bbox_coordinate_system": "docling_provenance", "source_parser": "docling", "source_id": "#/texts/3", "source_label": "text", "parent_ref": "#/body", "inside_picture": false, "table_rows": [], "is_auxiliary": false, "include_in_text_score": true, "hybrid_block_id": "#/texts/3", "source_order": 5, "is_toc": false, "include_in_text_output": true, "page_is_toc": false}
