{"document_id": "original", "page_number": 2, "section_id": "SEC001", "section_title": "信達生物製藥", "paragraph_id": "original__docling__p2_015", "block_type": "paragraph", "text": "本公司仍全⼒投入本公司的近期及長期增長，並對此充滿信心，本公司將繼續堅 定向成長為國際⼀流的生物製藥公司的願景邁進。", "bbox": {"l": 42.5197, "t": 747.9470887695312, "r": 552.7846999999995, "b": 718.8405266780279, "coord_origin": "BOTTOMLEFT"}, "bbox_coordinate_system": "docling_provenance", "source_parser": "docling", "source_id": "#/texts/14", "source_label": "text", "parent_ref": "#/body", "inside_picture": false, "table_rows": [], "is_auxiliary": false, "include_in_text_score": true, "hybrid_block_id": "#/texts/14", "source_order": 15, "is_toc": false, "include_in_text_output": true, "page_is_toc": false}
