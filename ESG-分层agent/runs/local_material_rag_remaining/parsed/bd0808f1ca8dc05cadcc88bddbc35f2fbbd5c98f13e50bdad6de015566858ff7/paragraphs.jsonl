{"type": "paragraph", "paragraph_id": "P3_005", "section": "10. Employee Engagement and Continuous Improvement", "section_id": "SEC003", "page": 3, "pages": [3], "text": "This policy is available to all employees. GenScript reserves the right to revise, modify, or repeal the policy at any time for any reason. Any updates to the policy will be promptly communicated to employees.", "block_type": "paragraph", "paragraph_role": "body", "body_only": true, "local_heading": "12. Availability and Revision", "source_block_ids": ["#/texts/34"], "source_block_id": "#/texts/34", "source_parsers": ["docling"], "source_parser": "docling", "source_tools": ["docling"], "bboxes": [{"page": 3, "bbox": [72.02, 472.47, 534.82, 510.41], "source_block_id": "#/texts/34", "source_parser": "docling"}], "bbox": [72.02, 472.47, 534.82, 510.41], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "en", "document_order": 33, "merge_method": "docling_layout_tracks_v4"}
