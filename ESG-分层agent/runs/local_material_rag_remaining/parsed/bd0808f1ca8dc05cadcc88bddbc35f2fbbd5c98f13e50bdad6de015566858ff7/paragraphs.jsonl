{"type": "title", "paragraph_id": "H1_001", "section": "Front matter", "section_id": "SEC001", "page": 1, "pages": [1], "text": "Diversity, Equity and Inclusion Policy", "block_type": "title", "source_parser": "docling", "source_block_id": "#/texts/0", "source_block_ids": ["#/texts/0"], "bbox": [102.02, 174.2550799999999, 363.82, 187.6793745454545], "bboxes": [{"page": 1, "bbox": [102.02, 174.2550799999999, 363.82, 187.6793745454545], "source_block_id": "#/texts/0", "source_parser": "docling"}], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "mixed", "merge_method": "docling_semantic_title", "document_order": 1}
{"type": "title", "paragraph_id": "H1_002", "section": "Front matter", "section_id": "SEC001", "page": 1, "pages": [1], "text": "1. Introduction", "block_type": "title", "source_parser": "docling", "source_block_id": "#/texts/1", "source_block_ids": ["#/texts/1"], "bbox": [72.024, 245.81599999999992, 157.22, 255.90945454545454], "bboxes": [{"page": 1, "bbox": [72.024, 245.81599999999992, 157.22, 255.90945454545454], "source_block_id": "#/texts/1", "source_parser": "docling"}], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "mixed", "merge_method": "docling_semantic_title", "document_order": 2}
{"type": "paragraph", "paragraph_id": "P1_001", "section": "Front matter", "section_id": "SEC001", "page": 1, "pages": [1], "text": "This Diversity, Equity, and Inclusion Policy aims to improve the corporate culture of GenScript Biotech Corporation (hereinafter referred to as 'GenScript', 'the Company' or 'we'), promote a workplace that values equity, impartiality and integrity, eliminate all forms of prejudice and discrimination, and improve employees' well-being and sense of belonging.", "block_type": "paragraph", "paragraph_role": "body", "body_only": true, "local_heading": "1. Introduction", "source_block_ids": ["#/texts/2"], "source_block_id": "#/texts/2", "source_parsers": ["docling"], "source_parser": "docling", "source_tools": ["docling"], "bboxes": [{"page": 1, "bbox": [72.02, 265.45, 529.22, 317.19], "source_block_id": "#/texts/2", "source_parser": "docling"}], "bbox": [72.02, 265.45, 529.22, 317.19], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "en", "document_order": 3, "merge_method": "docling_layout_tracks_v4"}
{"type": "title", "paragraph_id": "H1_003", "section": "Front matter", "section_id": "SEC001", "page": 1, "pages": [1], "text": "2. Scope", "block_type": "title", "source_parser": "docling", "source_block_id": "#/texts/3", "source_block_ids": ["#/texts/3"], "bbox": [72.024, 346.64599999999996, 122.54, 356.7394545454545], "bboxes": [{"page": 1, "bbox": [72.024, 346.64599999999996, 122.54, 356.7394545454545], "source_block_id": "#/texts/3", "source_parser": "docling"}], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "mixed", "merge_method": "docling_semantic_title", "document_order": 4}
{"type": "paragraph", "paragraph_id": "P1_002", "section": "Front matter", "section_id": "SEC001", "page": 1, "pages": [1], "text": "This policy applies to GenScript Biotech Corporation and its subsidiaries and affiliates worldwide. All employees, whether full-time, part-time, interns, consultants, or temporary staff, as well as suppliers, contractors, or other business partners, are required to comply with this policy.", "block_type": "paragraph", "paragraph_role": "body", "body_only": true, "local_heading": "2. Scope", "source_block_ids": ["#/texts/4"], "source_block_id": "#/texts/4", "source_parsers": ["docling"], "source_parser": "docling", "source_tools": ["docling"], "bboxes": [{"page": 1, "bbox": [72.02, 366.25, 526.78, 417.99], "source_block_id": "#/texts/4", "source_parser": "docling"}], "bbox": [72.02, 366.25, 526.78, 417.99], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "en", "document_order": 5, "merge_method": "docling_layout_tracks_v4"}
{"type": "title", "paragraph_id": "H1_004", "section": "Front matter", "section_id": "SEC001", "page": 1, "pages": [1], "text": "3. Governance", "block_type": "title", "source_parser": "docling", "source_block_id": "#/texts/5", "source_block_ids": ["#/texts/5"], "bbox": [72.024, 447.46599999999995, 153.98, 457.5594545454545], "bboxes": [{"page": 1, "bbox": [72.024, 447.46599999999995, 153.98, 457.5594545454545], "source_block_id": "#/texts/5", "source_parser": "docling"}], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "mixed", "merge_method": "docling_semantic_title", "document_order": 6}
{"type": "paragraph", "paragraph_id": "P1_003", "section": "Front matter", "section_id": "SEC001", "page": 1, "pages": [1], "text": "The Company has established the Risk Management and ESG Committee at the Board level, responsible for developing , managing, supervising, and implementing the Company's Diversity, Equity and Inclusion ('DEI') strategy. The management and the Human Resources Department work to integrate the DEI policy into business operations, provide DEI policy training to all personnel, facilitate the implementation of DEI programs, and regularly update the Risk Management and ESG Committee on DEI progress.", "block_type": "paragraph", "paragraph_role": "body", "body_only": true, "local_heading": "3. Governance", "source_block_ids": ["#/texts/6"], "source_block_id": "#/texts/6", "source_parsers": ["docling"], "source_parser": "docling", "source_tools": ["docling"], "bboxes": [{"page": 1, "bbox": [72.02, 467.07, 526.9, 546.41], "source_block_id": "#/texts/6", "source_parser": "docling"}], "bbox": [72.02, 467.07, 526.9, 546.41], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "en", "document_order": 7, "merge_method": "docling_layout_tracks_v4"}
{"type": "paragraph", "paragraph_id": "P1_004", "section": "Front matter", "section_id": "SEC001", "page": 1, "pages": [1], "text": "This policy has been reviewed by the management to ensure it appropriately states our global stance on DEI. The management will regularly review the Company's DEI policies, programs and actions to ensure effective implementation in all circumstances.", "block_type": "paragraph", "paragraph_role": "body", "body_only": true, "local_heading": "3. Governance", "source_block_ids": ["#/texts/7"], "source_block_id": "#/texts/7", "source_parsers": ["docling"], "source_parser": "docling", "source_tools": ["docling"], "bboxes": [{"page": 1, "bbox": [72.02, 555.87, 526.9, 593.81], "source_block_id": "#/texts/7", "source_parser": "docling"}], "bbox": [72.02, 555.87, 526.9, 593.81], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "en", "document_order": 8, "merge_method": "docling_layout_tracks_v4"}
{"type": "title", "paragraph_id": "H1_005", "section": "Front matter", "section_id": "SEC001", "page": 1, "pages": [1], "text": "4. Recruiting Diverse Talents", "block_type": "title", "source_parser": "docling", "source_block_id": "#/texts/8", "source_block_ids": ["#/texts/8"], "bbox": [72.024, 623.2959999999999, 229.61, 633.3894545454546], "bboxes": [{"page": 1, "bbox": [72.024, 623.2959999999999, 229.61, 633.3894545454546], "source_block_id": "#/texts/8", "source_parser": "docling"}], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "mixed", "merge_method": "docling_semantic_title", "document_order": 9}
{"type": "paragraph", "paragraph_id": "P1_005", "section": "Front matter", "section_id": "SEC001", "page": 1, "pages": [1], "text": "The Company is committed to attracting a global talent pool through a diverse recruitment strategy. We ensure that our recruitment process is inclusive, standardized, and transparent. We prohibit discrimination on the grounds of gender, region, race, ethnicity, sexual orientation, marital status, disability, religion, or political affiliation.", "block_type": "paragraph", "paragraph_role": "body", "body_only": true, "local_heading": "4. Recruiting Diverse Talents", "source_block_ids": ["#/texts/9"], "source_block_id": "#/texts/9", "source_parsers": ["docling"], "source_parser": "docling", "source_tools": ["docling"], "bboxes": [{"page": 1, "bbox": [72.02, 642.9, 526.9, 694.64], "source_block_id": "#/texts/9", "source_parser": "docling"}], "bbox": [72.02, 642.9, 526.9, 694.64], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "en", "document_order": 10, "merge_method": "docling_layout_tracks_v4"}
{"type": "paragraph", "paragraph_id": "P1_006", "section": "Front matter", "section_id": "SEC001", "page": 1, "pages": [1], "text": "The Company has developed internal policies and guidelines, such as the Employee Handbook and the Recruiting and Onboarding Management Policy, which are designed to safeguard the legal rights and interests of all employees and provide fair, equitable, and diverse development opportunities for all.", "block_type": "paragraph", "paragraph_role": "body", "body_only": true, "local_heading": "4. Recruiting Diverse Talents", "source_block_ids": ["#/texts/10"], "source_block_id": "#/texts/10", "source_parsers": ["docling"], "source_parser": "docling", "source_tools": ["docling"], "bboxes": [{"page": 1, "bbox": [72.02, 704.1, 526.28, 755.83], "source_block_id": "#/texts/10", "source_parser": "docling"}], "bbox": [72.02, 704.1, 526.28, 755.83], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "en", "document_order": 11, "merge_method": "docling_layout_tracks_v4"}
{"type": "title", "paragraph_id": "H2_001", "section": "5. Promoting Diverse Talent Development", "section_id": "SEC002", "page": 2, "pages": [2], "text": "5. Promoting Diverse Talent Development", "block_type": "title", "source_parser": "docling", "source_block_id": "#/texts/12", "source_block_ids": ["#/texts/12"], "bbox": [72.024, 91.01599999999996, 295.13, 101.10945454545458], "bboxes": [{"page": 2, "bbox": [72.024, 91.01599999999996, 295.13, 101.10945454545458], "source_block_id": "#/texts/12", "source_parser": "docling"}], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "mixed", "merge_method": "docling_semantic_title", "document_order": 12}
{"type": "paragraph", "paragraph_id": "P2_001", "section": "5. Promoting Diverse Talent Development", "section_id": "SEC002", "page": 2, "pages": [2], "text": "The Company offers diverse and equal opportunities in promotion and development. Our compensation and benefits policies are determined based on position, experience, capability, and performance, ensuring a merit-based approach. We are committed to fostering an environment where all individuals, regardless of race, skin color, gender, religion, nationality, disability, sexual orientation, gender identity, marital status, or any other protected status are treated with equality and respect.", "block_type": "paragraph", "paragraph_role": "body", "body_only": true, "local_heading": "5. Promoting Diverse Talent Development", "source_block_ids": ["#/texts/13"], "source_block_id": "#/texts/13", "source_parsers": ["docling"], "source_parser": "docling", "source_tools": ["docling"], "bboxes": [{"page": 2, "bbox": [72.02, 110.62, 526.89, 189.96], "source_block_id": "#/texts/13", "source_parser": "docling"}], "bbox": [72.02, 110.62, 526.89, 189.96], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "en", "document_order": 13, "merge_method": "docling_layout_tracks_v4"}
{"type": "title", "paragraph_id": "H2_002", "section": "5. Promoting Diverse Talent Development", "section_id": "SEC002", "page": 2, "pages": [2], "text": "6. Training and Awareness", "block_type": "title", "source_parser": "docling", "source_block_id": "#/texts/14", "source_block_ids": ["#/texts/14"], "bbox": [72.024, 219.41599999999994, 217.85, 229.50945454545456], "bboxes": [{"page": 2, "bbox": [72.024, 219.41599999999994, 217.85, 229.50945454545456], "source_block_id": "#/texts/14", "source_parser": "docling"}], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "mixed", "merge_method": "docling_semantic_title", "document_order": 14}
{"type": "paragraph", "paragraph_id": "P2_002", "section": "5. Promoting Diverse Talent Development", "section_id": "SEC002", "page": 2, "pages": [2], "text": "The Company maintains a robust training system to enhance employees' awareness of diversity. This includes building a diverse pool of trainers comprising employees and external experts from various backgrounds. We provide cultural training to help employees recognize the significance of working in a diverse team and to prevent discrimination or bias, whether conscious or unconscious. We provide a range of career development programs and ample training support to all employees to ensure their growth and success.", "block_type": "paragraph", "paragraph_role": "body", "body_only": true, "local_heading": "6. Training and Awareness", "source_block_ids": ["#/texts/15"], "source_block_id": "#/texts/15", "source_parsers": ["docling"], "source_parser": "docling", "source_tools": ["docling"], "bboxes": [{"page": 2, "bbox": [72.02, 239.02, 526.89, 318.39], "source_block_id": "#/texts/15", "source_parser": "docling"}], "bbox": [72.02, 239.02, 526.89, 318.39], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "en", "document_order": 15, "merge_method": "docling_layout_tracks_v4"}
{"type": "title", "paragraph_id": "H2_003", "section": "5. Promoting Diverse Talent Development", "section_id": "SEC002", "page": 2, "pages": [2], "text": "7. Human Rights and Working Conditions", "block_type": "title", "source_parser": "docling", "source_block_id": "#/texts/16", "source_block_ids": ["#/texts/16"], "bbox": [72.024, 347.84599999999995, 295.25, 357.9394545454545], "bboxes": [{"page": 2, "bbox": [72.024, 347.84599999999995, 295.25, 357.9394545454545], "source_block_id": "#/texts/16", "source_parser": "docling"}], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "mixed", "merge_method": "docling_semantic_title", "document_order": 16}
{"type": "paragraph", "paragraph_id": "P2_003", "section": "5. Promoting Diverse Talent Development", "section_id": "SEC002", "page": 2, "pages": [2], "text": "The Company upholds the principles and values of the International Labor Organization (ILO), the Universal Declaration of Human Rights (UDHR), the International Bill of Human Rights, and the United Nations Guiding Principles on Business and Human Rights. We protect the fundamental rights and interests of employees in strict accordance with the applicable laws and regulations of the jurisdictions where we operate. These rights and interests include but are not limited to the living wage, maximum working hours, flexible shift arrangements, overtime, and statutory benefits. We respect employees' work-life balance and arrange working hours reasonably, striving to minimizing excessive overtime. We also support employees' freedom of association and speech, as well as their collective bargaining rights, encouraging them to express personal opinions and protecting their rights.", "block_type": "paragraph", "paragraph_role": "body", "body_only": true, "local_heading": "7. Human Rights and Working Conditions", "source_block_ids": ["#/texts/17"], "source_block_id": "#/texts/17", "source_parsers": ["docling"], "source_parser": "docling", "source_tools": ["docling"], "bboxes": [{"page": 2, "bbox": [72.02, 367.45, 526.9, 502.01], "source_block_id": "#/texts/17", "source_parser": "docling"}], "bbox": [72.02, 367.45, 526.9, 502.01], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "en", "document_order": 17, "merge_method": "docling_layout_tracks_v4"}
{"type": "paragraph", "paragraph_id": "P2_004", "section": "5. Promoting Diverse Talent Development", "section_id": "SEC002", "page": 2, "pages": [2], "text": "To mitigate the negative impacts of layoffs, the Company will provide advance notice of mass layoffs that exceeds the statutory notice period in accordance with local laws and regulations of the jurisdictions where we operate, ensuring the protection of employees' rights and interests.", "block_type": "paragraph", "paragraph_role": "body", "body_only": true, "local_heading": "7. Human Rights and Working Conditions", "source_block_ids": ["#/texts/18"], "source_block_id": "#/texts/18", "source_parsers": ["docling"], "source_parser": "docling", "source_tools": ["docling"], "bboxes": [{"page": 2, "bbox": [72.02, 511.47, 526.9, 563.21], "source_block_id": "#/texts/18", "source_parser": "docling"}], "bbox": [72.02, 511.47, 526.9, 563.21], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "en", "document_order": 18, "merge_method": "docling_layout_tracks_v4"}
{"type": "title", "paragraph_id": "H2_004", "section": "5. Promoting Diverse Talent Development", "section_id": "SEC002", "page": 2, "pages": [2], "text": "8. Anti-Harassment Policy", "block_type": "title", "source_parser": "docling", "source_block_id": "#/texts/19", "source_block_ids": ["#/texts/19"], "bbox": [72.024, 592.6659999999999, 215.09, 602.7594545454544], "bboxes": [{"page": 2, "bbox": [72.024, 592.6659999999999, 215.09, 602.7594545454544], "source_block_id": "#/texts/19", "source_parser": "docling"}], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "mixed", "merge_method": "docling_semantic_title", "document_order": 19}
{"type": "paragraph", "paragraph_id": "P2_005", "section": "5. Promoting Diverse Talent Development", "section_id": "SEC002", "page": 2, "pages": [2], "text": "The Company strictly prohibits any form of harassment in the workplace, including verbal, physical, or online harassment. We maintain a zero-tolerance policy on such behavior. Any employee found to be engaging in harassment will be subject to disciplinary action, up to and including termination.", "block_type": "paragraph", "paragraph_role": "body", "body_only": true, "local_heading": "8. Anti-Harassment Policy", "source_block_ids": ["#/texts/20"], "source_block_id": "#/texts/20", "source_parsers": ["docling"], "source_parser": "docling", "source_tools": ["docling"], "bboxes": [{"page": 2, "bbox": [72.02, 612.3, 526.78, 664.04], "source_block_id": "#/texts/20", "source_parser": "docling"}], "bbox": [72.02, 612.3, 526.78, 664.04], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "en", "document_order": 20, "merge_method": "docling_layout_tracks_v4"}
{"type": "title", "paragraph_id": "H2_005", "section": "5. Promoting Diverse Talent Development", "section_id": "SEC002", "page": 2, "pages": [2], "text": "9. Commitment to Physical and Mental Health of Employees", "block_type": "title", "source_parser": "docling", "source_block_id": "#/texts/21", "source_block_ids": ["#/texts/21"], "bbox": [72.024, 693.496, 389.11, 703.5894545454545], "bboxes": [{"page": 2, "bbox": [72.024, 693.496, 389.11, 703.5894545454545], "source_block_id": "#/texts/21", "source_parser": "docling"}], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "mixed", "merge_method": "docling_semantic_title", "document_order": 21}
{"type": "paragraph", "paragraph_id": "P2_006", "section": "5. Promoting Diverse Talent Development", "section_id": "SEC002", "page": 2, "pages": [2], "text": "The Company prioritizes the physical and mental health of employees. To promote a healthy and happy lifestyle, we have established various workplace clubs and regularly organized activities aimed at relieving stress and fostering a positive work environment. These clubs also serve as platforms for team building and enhancing corporate cohesion.", "block_type": "paragraph", "paragraph_role": "body", "body_only": true, "local_heading": "9. Commitment to Physical and Mental Health of Employees", "source_block_ids": ["#/texts/22"], "source_block_id": "#/texts/22", "source_parsers": ["docling"], "source_parser": "docling", "source_tools": ["docling"], "bboxes": [{"page": 2, "bbox": [72.02, 713.1, 526.9, 764.83], "source_block_id": "#/texts/22", "source_parser": "docling"}], "bbox": [72.02, 713.1, 526.9, 764.83], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "en", "document_order": 22, "merge_method": "docling_layout_tracks_v4"}
{"type": "title", "paragraph_id": "H3_001", "section": "10. Employee Engagement and Continuous Improvement", "section_id": "SEC003", "page": 3, "pages": [3], "text": "10. Employee Engagement and Continuous Improvement", "block_type": "title", "source_parser": "docling", "source_block_id": "#/texts/24", "source_block_ids": ["#/texts/24"], "bbox": [72.024, 110.81599999999992, 366.67, 120.90945454545454], "bboxes": [{"page": 3, "bbox": [72.024, 110.81599999999992, 366.67, 120.90945454545454], "source_block_id": "#/texts/24", "source_parser": "docling"}], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "mixed", "merge_method": "docling_semantic_title", "document_order": 23}
{"type": "paragraph", "paragraph_id": "P3_001", "section": "10. Employee Engagement and Continuous Improvement", "section_id": "SEC003", "page": 3, "pages": [3], "text": "The Company conducts annual internal surveys and evaluations to measure employee satisfaction. We take employee feedback into account when reviewing and enhancing competitive benefits, training, and development programs. We use survey insights to make targeted adjustments to our diversity and inclusion initiatives.", "block_type": "paragraph", "paragraph_role": "body", "body_only": true, "local_heading": "10. Employee Engagement and Continuous Improvement", "source_block_ids": ["#/texts/25"], "source_block_id": "#/texts/25", "source_parsers": ["docling"], "source_parser": "docling", "source_tools": ["docling"], "bboxes": [{"page": 3, "bbox": [72.02, 130.42, 526.66, 182.16], "source_block_id": "#/texts/25", "source_parser": "docling"}], "bbox": [72.02, 130.42, 526.66, 182.16], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "en", "document_order": 24, "merge_method": "docling_layout_tracks_v4"}
{"type": "title", "paragraph_id": "H3_002", "section": "10. Employee Engagement and Continuous Improvement", "section_id": "SEC003", "page": 3, "pages": [3], "text": "11. Reporting Channels", "block_type": "title", "source_parser": "docling", "source_block_id": "#/texts/26", "source_block_ids": ["#/texts/26"], "bbox": [72.024, 211.61599999999999, 195.17, 221.7094545454546], "bboxes": [{"page": 3, "bbox": [72.024, 211.61599999999999, 195.17, 221.7094545454546], "source_block_id": "#/texts/26", "source_parser": "docling"}], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "mixed", "merge_method": "docling_semantic_title", "document_order": 25}
{"type": "paragraph", "paragraph_id": "P3_002", "section": "10. Employee Engagement and Continuous Improvement", "section_id": "SEC003", "page": 3, "pages": [3], "text": "The Company encourages employees to report any suspected discrimination, harassment, or unfair treatment through various compliance channels. We are committed to maintaining the confidentiality of information provided by whistleblowers and to protecting them from any form of retaliation.", "block_type": "paragraph", "paragraph_role": "body", "body_only": true, "local_heading": "11. Reporting Channels", "source_block_ids": ["#/texts/27"], "source_block_id": "#/texts/27", "source_parsers": ["docling"], "source_parser": "docling", "source_tools": ["docling"], "bboxes": [{"page": 3, "bbox": [72.02, 231.22, 526.65, 282.99], "source_block_id": "#/texts/27", "source_parser": "docling"}], "bbox": [72.02, 231.22, 526.65, 282.99], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "en", "document_order": 26, "merge_method": "docling_layout_tracks_v4"}
{"type": "paragraph", "paragraph_id": "P3_003", "section": "10. Employee Engagement and Continuous Improvement", "section_id": "SEC003", "page": 3, "pages": [3], "text": "Upon receiving reports of violations, the Internal Audit Department and the Human Resources Department will respond promptly. The Company will handle all reported violations seriously, conduct thorough investigations, and provide timely feedback to the whistleblowers. If the reported violations are confirmed, the Company will take corrective actions as necessary.", "block_type": "paragraph", "paragraph_role": "body", "body_only": true, "local_heading": "11. Reporting Channels", "source_block_ids": ["#/texts/28"], "source_block_id": "#/texts/28", "source_parsers": ["docling"], "source_parser": "docling", "source_tools": ["docling"], "bboxes": [{"page": 3, "bbox": [72.02, 292.45, 526.9, 344.19], "source_block_id": "#/texts/28", "source_parser": "docling"}], "bbox": [72.02, 292.45, 526.9, 344.19], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "en", "document_order": 27, "merge_method": "docling_layout_tracks_v4"}
{"type": "paragraph", "paragraph_id": "P3_004", "section": "10. Employee Engagement and Continuous Improvement", "section_id": "SEC003", "page": 3, "pages": [3], "text": "The Company offers reporting channels including but not limited to:", "block_type": "paragraph", "paragraph_role": "body", "body_only": true, "local_heading": "11. Reporting Channels", "source_block_ids": ["#/texts/29"], "source_block_id": "#/texts/29", "source_parsers": ["docling"], "source_parser": "docling", "source_tools": ["docling"], "bboxes": [{"page": 3, "bbox": [70.82, 353.65, 401.59, 363.99], "source_block_id": "#/texts/29", "source_parser": "docling"}], "bbox": [70.82, 353.65, 401.59, 363.99], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "en", "document_order": 28, "merge_method": "docling_layout_tracks_v4"}
{"type": "paragraph", "paragraph_id": "L3_001", "section": "10. Employee Engagement and Continuous Improvement", "section_id": "SEC003", "page": 3, "pages": [3], "text": "-Report to your superiors, Human Resources Department or Internal Audit Department", "block_type": "list", "paragraph_role": "body", "body_only": true, "local_heading": "11. Reporting Channels", "source_block_ids": ["#/texts/30"], "source_block_id": "#/texts/30", "source_parsers": ["docling"], "source_parser": "docling", "source_tools": ["docling"], "bboxes": [{"page": 3, "bbox": [72.02, 373.45, 494.38, 383.79], "source_block_id": "#/texts/30", "source_parser": "docling"}], "bbox": [72.02, 373.45, 494.38, 383.79], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "en", "document_order": 29, "merge_method": "docling_layout_tracks_v4"}
