{"type": "paragraph", "paragraph_id": "P2_007", "section": "管理通道", "section_id": "SEC002", "page": 2, "pages": [2], "text": "双通道体系支持灵活转换机制,员工可根据个人发展与组织需求,在管理与技术 通道间横向流动。公司确保两条通道在薪酬、资源分配和发展机会上保持平等。", "block_type": "paragraph", "paragraph_role": "body", "body_only": true, "local_heading": "技术通道", "source_block_ids": ["#/texts/20"], "source_block_id": "#/texts/20", "source_parsers": ["docling"], "source_parser": "docling", "source_tools": ["docling"], "bboxes": [{"page": 2, "bbox": [90.02, 445.73, 510.02, 486.84], "source_block_id": "#/texts/20", "source_parser": "docling"}], "bbox": [90.02, 445.73, 510.02, 486.84], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "zh", "document_order": 19, "merge_method": "docling_layout_tracks_v4"}
