{"type": "paragraph", "paragraph_id": "P4_001", "section": "发展紧密相连。", "section_id": "SEC003", "page": 4, "pages": [4], "text": "全面认可体系:建立包括创新模范、技能标兵、商业贡献等在内的多元认可体系, 通过物质奖励与精神荣誉相结合的方式,全面激励员工。", "block_type": "paragraph", "paragraph_role": "body", "body_only": true, "local_heading": "发展紧密相连。", "source_block_ids": ["#/texts/37"], "source_block_id": "#/texts/37", "source_parsers": ["docling"], "source_parser": "docling", "source_tools": ["docling"], "bboxes": [{"page": 4, "bbox": [90.02, 122.28, 511.22, 163.39], "source_block_id": "#/texts/37", "source_parser": "docling"}], "bbox": [90.02, 122.28, 511.22, 163.39], "bbox_coordinate_system": "pdf_points_top_left", "cross_page": false, "language": "zh", "document_order": 34, "merge_method": "docling_layout_tracks_v4"}
